POSTGRES_DB=pilotproof
POSTGRES_USER=pilotproof
# For Docker Compose, set both secrets to independent random values. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=
SEED_DEMO_USERS=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_ENV=development
SECRET_KEY=
OIDC_ISSUER=

# Optional challenge drafting provider; deterministic mock is used when unset.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
